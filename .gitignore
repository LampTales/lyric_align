# Python/editor caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.DS_Store
.env
.env.*
*.key
*.pem

# Generated alignment reports and temporary logs
results/
*.log

# Downloaded model weights and derived acoustic artifacts
models/
artifacts/
checkpoints/

# Local regression samples are intentionally kept outside Git.
# They are copied from the original repository and may contain large media.
samples/

# Scratch copies, model intermediates and test outputs. Keep the directory
# itself documented, but never commit its contents.
temp/*
!temp/README.md
